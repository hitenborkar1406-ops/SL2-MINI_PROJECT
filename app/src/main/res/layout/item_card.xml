<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:strokeWidth="0dp">

    <!-- Root wrapper lets us stack overlay on top of content  -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- ── Card content ──────────────────────────────── -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="96dp">

            <!-- Left colored strip (color set from adapter) -->
            <View
                android:id="@+id/viewStrip"
                android:layout_width="6dp"
                android:layout_height="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Thumbnail -->
            <ImageView
                android:id="@+id/ivThumbnail"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginStart="14dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:scaleType="centerCrop"
                android:contentDescription="Item thumbnail"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/viewStrip"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Item name -->
            <TextView
                android:id="@+id/tvItemName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="4dp"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/textPrimary"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivThumbnail"
                app:layout_constraintEnd_toStartOf="@id/tvItemType" />

            <!-- Type badge (top-right) -->
            <TextView
                android:id="@+id/tvItemType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="12dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Location -->
            <TextView
                android:id="@+id/tvItemLocation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="8dp"
                android:textSize="13sp"
                android:textColor="@color/textSecondary"
                android:maxLines="1"
                android:ellipsize="end"
                app:layout_constraintTop_toBottomOf="@id/tvItemName"
                app:layout_constraintStart_toEndOf="@id/ivThumbnail"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Timestamp ("Posted 2h ago") -->
            <TextView
                android:id="@+id/tvTimestamp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="12dp"
                android:textSize="11sp"
                android:textColor="@color/textSecondary"
                android:alpha="0.7"
                app:layout_constraintTop_toBottomOf="@id/tvItemLocation"
                app:layout_constraintStart_toEndOf="@id/ivThumbnail"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ── RETURNED overlay (shown when status = resolved) ── -->
        <FrameLayout
            android:id="@+id/resolvedOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#CC1B5E20"
            android:visibility="gone"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="✓  RETURNED"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />
        </FrameLayout>

    </FrameLayout>

</com.google.android.material.card.MaterialCardView>
